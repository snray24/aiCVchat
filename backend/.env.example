APP_NAME=Resume Chatbot
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Emergency only — prefer registered embed domains (default false)
CORS_ALLOW_ANY_ORIGIN=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_chatbot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:12b
OLLAMA_EMBED_MODEL=embeddinggemma
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
ADMIN_TOKEN=change-me-in-production
ALLOWLIST_ENCRYPTION_KEY=
MAX_RESUMES_PER_REQUEST=5
RESUME_DATA_DIR=backend/data/resumes

# Embed abuse protection
EMBED_AUTH_REQUIRED=true
EMBED_TOKEN_SECRET=change-me-to-a-long-random-string
EMBED_TOKEN_TTL_SECONDS=600
EMBED_RATE_LIMIT_PER_MINUTE=20
EMBED_SITE_RATE_LIMIT_PER_MINUTE=60
# Leave unset to require HTTPS only when APP_ENV=production
# EMBED_REQUIRE_HTTPS=true
# Set true only behind a trusted reverse proxy (nginx/Cloudflare) that sets X-Forwarded-*
TRUST_PROXY=false
